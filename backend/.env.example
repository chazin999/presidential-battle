# Porta do servidor HTTP/WebSocket
PORT=4000

# Origem permitida para CORS (URL do frontend)
FRONTEND_ORIGIN=http://localhost:5173

# --- TikTok Login Kit (OAuth oficial) ---
# Necessário criar um app em https://developers.tiktok.com/
# Estas credenciais NUNCA devem ser expostas no frontend.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/auth/tiktok/callback

# Fonte de eventos de presente: "mock" (padrão, sem integração real)
# ou "live" (requer TIKTOK_LIVE_PROVIDER_URL configurada por uma
# integração oficial/homologada, quando disponível — ver README).
GIFT_EVENT_SOURCE=mock
TIKTOK_LIVE_PROVIDER_URL=

# Caminho do arquivo do banco de dados SQLite
DATABASE_PATH=./data/battle.db
